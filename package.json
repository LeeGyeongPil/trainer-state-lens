{
  "name": "trainer-state-lens",
  "version": "0.2.0",
  "description": "Drop Hugging Face trainer_state.json files into your browser and get overlaid training curves plus rule-based diagnoses (overfit, spikes, divergence, LR schedule, DPO likelihood displacement, GRPO stall).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
